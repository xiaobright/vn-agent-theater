# 复制为 .env 后填密钥；mock 无需密钥、不调用模型接口。
# 通用字段只服务 LLM_PROVIDER 指定的默认提供方。
# 显式切换 longcat 时不会继承默认提供方的 URL / model / key。
LLM_PROVIDER=stepfun
STEPFUN_API_KEY=
# STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
# STEPFUN_MODEL=step-5-preview
LLM_TEMPERATURE=0.8
LLM_REASONING=medium

# 所有岗位统一排队。上限取 全局 / 端点 / 账户配额组 三者允许的最小值。
# 同一进程有效：不要用多个 uvicorn workers 来规避配额。
LLM_GLOBAL_CONCURRENCY=2
LLM_PROVIDER_CONCURRENCY=2
LLM_QUOTA_CONCURRENCY=2
# 同一 coding plan 的不同 base URL 请填相同的组名。
LLM_QUOTA_GROUP=my-coding-plan
# 提供方可单独设置并发和账户组；不填组名时按端点分组。
# STEPFUN_CONCURRENCY=2
# STEPFUN_QUOTA_GROUP=my-coding-plan
# STEPFUN_QUOTA_CONCURRENCY=2

# 单次尝试时限和整个 chat（含排队、退避）的时限，单位秒。
LLM_REQUEST_TIMEOUT=90
LLM_REQUEST_DEADLINE=180
# 最多 2 次追加重试；SDK 内置重试已关闭。
LLM_MAX_RETRIES=2
LLM_RETRY_BASE=1
LLM_RETRY_CAP=30
# 注意：**推理 token 也算在 completion 预算里**（stepfun 实测：2366 completion 只吐出 93 字正文）。
# 所以要动脑的岗位用 4096 会写到一半就被截断；默认给 16384。
LLM_MAX_OUTPUT_TOKENS=16384
LLM_MAX_REVISIONS=1
# 只重试连接建立失败、429 与 500/502/503/504；额度/账单/鉴权错误停止。
# 读取超时结果不确定，默认停止；取消本地等待不能保证上游停止计费。
# Retry-After 是最小等待，超过总时限则停止，不用 RETRY_CAP 提前截短。
# 429 冷却整个账户组；排队和退避不占用请求许可。

# 第二个提供方：使用自己独立的凭据和模型，可与默认提供方并行。
LONGCAT_API_KEY=
# LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
# LONGCAT_MODEL=LongCat-2.5-Preview
# LONGCAT_CONCURRENCY=1
# LONGCAT_QUOTA_GROUP=another-plan
# LONGCAT_QUOTA_CONCURRENCY=1

# 自定义默认提供方示例（取消注释并填写）：
# LLM_PROVIDER=custom
# LLM_API_KEY=
# LLM_BASE_URL=https://your-endpoint.example/v1
# LLM_MODEL=your-model
# 第二个自定义提供方应使用自己的前缀，例如 OTHER_API_KEY/BASE_URL/MODEL。

# 每岗位可覆盖 PROVIDER / MODEL / BASE_URL / API_KEY / QUOTA_GROUP。
# KEY 映射：DIRECTOR 总编；CONTINUITY 时间线、规则审查、状态提议；
# WRITER 主笔与定向修改；REVIEWER 玩家审读；JUDGE 对比评审；SINGLE 单模型；
# PROTAGONIST 主角；LEADER 首领；SWING 摇摆者。群聊复用同一岗位。
# 未知英文岗位按大写下划线作为 KEY；未知中文岗位回退全局配置。
# ROLE_WRITER_PROVIDER=longcat
# ROLE_CONTINUITY_PROVIDER=stepfun
# ROLE_PROTAGONIST_MODEL=another-model
# 同一账户的不同入口示例：
# ROLE_LEADER_BASE_URL=https://another-endpoint.example/v1
# ROLE_LEADER_QUOTA_GROUP=my-coding-plan
